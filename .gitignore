# SLURM job artefacts (written next to the script by run_julia.sbatch's %x_%j)
*.out
*.err
.*_jid

# Julia
/deps/build.log
*.cov

# Benchmark result files -- regenerated, never committed
benchmarks/*.log
benchmarks/*.json

# Python bytecode from the plotting scripts
__pycache__/
*.pyc

# Generated campaign output. The SCRIPTS are tracked (benchmarks/*.jl, plot_*.py, *.slurm) so
# every figure here is reproducible from them; the CSVs and PNGs themselves are not, since they
# are multi-megabyte and regenerated on every run.
benchmarks/results/

# Generated by the example scripts (CSV) and plot_examples.py (PNG).
examples/results/
